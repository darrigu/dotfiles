[global]
follow = mouse
width = 300
height = 80
offset = (10, 42)
notification_limit = 0
progress_bar_height = 80
progress_bar_min_width = 300
progress_bar_max_width = 300
separator_height = 1
padding = 15
horizontal_padding = 15
frame_width = 1
idle_threshold = 120
font = Iosevka 10
line_height = 2
markup = full
format = %s\n%b
enable_recursive_icon_lookup = true
min_icon_size = 24
max_icon_size = 48

[urgency_low]
timeout = 2
background = "#2E3440"
foreground = "#D8DEE9"
frame_color = "#81A1C1"

[urgency_normal]
timeout = 5
background = "#2E3440"
foreground = "#D8DEE9"
frame_color = "#81A1C1"

[urgency_critical]
timeout = 0
background = "#2E3440"
foreground = "#BF616A"
frame_color = "#BF616A"
